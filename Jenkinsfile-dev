pipeline {
    agent any

    tools {
        nodejs 'nodeJs18.18.1'
    }

    environment {
        APP_ENV = 'development'
        PUERTO_EXTERNO = 3020
        IDENTIFICADOR_IMAGEN = 'front-inspectores'
        CARPETA_APLICACION = './'
    }

    stages {

        stage('Tools initialization') {
            steps {
                script {
                    DOCKER_VERSION = sh(returnStdout: true, script: 'docker version').trim()
                    NODE_VERSION   = sh(returnStdout: true, script: 'npm -v').trim()

                    echo "Docker version: ${DOCKER_VERSION}"
                    echo "Node version: ${NODE_VERSION}"
                    echo "APP_ENV (DEV): ${APP_ENV}"
                }
            }
        }

        stage('Build and run to Docker') {
            environment {
                PUERTO_INTERNO    = 80
                NOMBRE_CONTENEDOR = "front-inspectores-dev"
            }

            steps {
                script {
                    dir("${CARPETA_APLICACION}") {

                        if (!fileExists("Dockerfile")) {
                            error "Dockerfile not found"
                        }

                        def contenedorExistente = sh(
                            script: "docker ps -aqf name=${NOMBRE_CONTENEDOR}",
                            returnStdout: true
                        ).trim()

                        if (contenedorExistente) {
                            sh "docker stop $contenedorExistente"
                            sh "docker rm -f $contenedorExistente"
                        }

                        // DEV: usa .env.development
                        sh """
                          docker build \
                            --build-arg APP_ENV=${APP_ENV} \
                            -t ${IDENTIFICADOR_IMAGEN}:latest .
                        """

                        // Opcional: levantar el contenedor de DEV
                        // sh "docker run -d -p ${PUERTO_EXTERNO}:${PUERTO_INTERNO} --name ${NOMBRE_CONTENEDOR} ${IDENTIFICADOR_IMAGEN}:latest"
                    }
                }
            }
        }
    }
}
